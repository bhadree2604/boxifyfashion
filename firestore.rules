rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requesting user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'adminlog123@gmail.com'
      ];
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;
    }
    match /site_visits/{visitId} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    match /login_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if true;
    }
    match /purchases/{purchaseId} {
      // Customer can create a purchase attributed to themselves
      allow create: if request.auth != null
                    && request.resource.data.customer.id == request.auth.uid;
      // Admin can read all; customer can read their own
      allow read: if isAdmin() || resource.data.customer.id == request.auth.uid;
      // Only admin can update status (confirm/cancel)
      allow update: if isAdmin();
      // No delete allowed
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
